# Supabase project settings (Project Settings → API in the Supabase dashboard).
# The anon key is safe to expose in the browser — see docs/security.md for why
# that's safe (Row Level Security is what actually protects the data).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — server-only, NEVER exposed to the client, NEVER committed.
# Only needed for scripts/seed.ts (Phase 3) and admin tasks that must bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
